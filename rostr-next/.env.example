# Next.js + Supabase + Prisma env vars.
# Copy to .env.local and fill with your values.

# Supabase (public — used by client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Prisma (server-only — direct Postgres URL)
# For Supabase: Settings → Database → Connection string → URI
# Use the "Session" pooler URL for DATABASE_URL, "Direct" for DIRECT_URL (migrations).
DATABASE_URL=
DIRECT_URL=
