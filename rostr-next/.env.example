# Next.js + Supabase + Prisma env vars.
# Copy to .env.local and fill with your values.

# Supabase (public — used by client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Prisma (server-only — direct Postgres URL)
# For Supabase: Settings → Database → Connection string → URI
# Use the "Session" pooler URL for DATABASE_URL, "Direct" for DIRECT_URL (migrations).
DATABASE_URL=
DIRECT_URL=

# Anthropic (server-only — AI Assistant Coach + game-day prep AI fill)
# Leave unset and the AI Coach card renders a "not configured" state.
ANTHROPIC_API_KEY=

# ───────────────────────────────────────────────────────────────────
# Feature flags — pilot-safe isolation for unfinished modules.
#
# Default: all flags OFF. Set to "true" (lowercase, no quotes) in
# .env.local to enable a module locally for development. Production
# (Vercel) MUST omit these vars entirely so they read as off.
#
# Implementation: src/lib/feature-flags.ts. Adding a new flag
# requires updating both this file AND the FlagName union type so
# TypeScript catches drift.
# ───────────────────────────────────────────────────────────────────

# Advanced player profile UI (privacy toggles, prior-season stats,
# verified-vs-reported badges). Gates new /me/profile sections + new
# /p/[handle] cards beyond the v0 read-only profile.
NEXT_PUBLIC_ENABLE_ADVANCED_PLAYER_PROFILES=

# Player-typed prior-season stats. Sub-flag — also requires the
# advanced-profiles flag to be on.
NEXT_PUBLIC_ENABLE_PLAYER_SELF_REPORTED_STATS=

# Individualized training programs (workouts, weekly plans, athlete
# check-ins). Gates the entire feature surface; OFF until v2.
NEXT_PUBLIC_ENABLE_TRAINING_PROGRAMS=

# Athlete-facing AI assistant on /me. Distinct from the coach AI
# Assistant Coach (which ships unflagged). OFF until privacy review.
NEXT_PUBLIC_ENABLE_AI_PLAYER_ASSISTANT=
